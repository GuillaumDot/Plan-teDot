// GLSL ES 3.00 helper. Local normalized planet coordinates; distances in planet radii.
float pd17Noise(vec3 p){vec3 i=floor(p), f=fract(p); f=f*f*(3.-2.*f); vec4 k=vec4(0,1,57,58)+dot(i,vec3(1,57,113)); vec4 a=fract(sin(k)*43758.5453),b=fract(sin(k+113.)*43758.5453); vec4 v=mix(a,b,f.z); return mix(mix(v.x,v.y,f.x),mix(v.z,v.w,f.x),f.y);}
float pd17Fbm(vec3 p){return .57*pd17Noise(p)+.28*pd17Noise(p*2.03)+.15*pd17Noise(p*4.07);}
// kind: 0 cloud shell, 1 gas bands, 2 spectral shell, 3 local smoke plume
float pd17Density(vec3 p,float t,float seed,int kind){float r=length(p); vec3 q=p*7.+vec3(seed*.13,0.,t*.035); float n=pd17Fbm(q+2.*vec3(pd17Noise(q*.7),pd17Noise(q*.7+17.),pd17Noise(q*.7+31.))); if(kind==3){float y=p.y; float w=.08+.24*max(y,0.); vec2 drift=vec2(sin(y*5.+t*.3),cos(y*3.+t*.2))*.07*y; return smoothstep(0.,.08,y)*(1.-smoothstep(.65,1.,y))*(1.-smoothstep(w*.35,w,length(p.xz-drift)))*smoothstep(.25,.75,n);} float h=(r-1.)/.12; float shell=smoothstep(0.,.18,h)*(1.-smoothstep(.65,1.,h)); if(kind==1){float band=.5+.5*sin(p.y*36.+n*5.+t*.06); return shell*smoothstep(.25,.75,n*.55+band*.45);} if(kind==2)return shell*pow(max(n,0.),2.)*.8; return shell*smoothstep(.42,.68,n);}
// premultiplied linear RGB. Caller clips segment to opaque depth and shell bounds.
vec4 pd17March(vec3 ro,vec3 rd,float a,float b,vec3 sun,vec3 tint,float t,float seed,int kind,int steps,float jitter){vec4 acc=vec4(0.); int count=clamp(steps,1,32); float ds=max(b-a,0.)/float(count); if(ds<=0.)return acc; for(int i=0;i<32;i++){if(i>=count||acc.a>.985)break; vec3 p=ro+rd*(a+(float(i)+clamp(jitter,0.,.999))*ds); float d=pd17Density(p,t,seed,kind); if(d<.001)continue; float shadow=exp(-5.*(pd17Density(p+sun*.035,t,seed,kind)+pd17Density(p+sun*.085,t,seed,kind))); float mu=dot(rd,sun); float phase=.65+.35*mu*mu; vec3 lit=tint*(.25+.75*shadow*phase); if(kind==2)lit+=tint*.35; float alpha=1.-exp(-d*ds*24.); acc.rgb+=(1.-acc.a)*alpha*lit; acc.a+=(1.-acc.a)*alpha;} return acc;}
